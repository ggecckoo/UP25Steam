    "demo.introBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنلعب جولتين موجَّهتين معًا.\nالمس الورقة التي نوضحها وسنشرح كل خطوة.\nيمكنك إنهاء العرض في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir spielen 2 geführte Runden.\nTippe die angezeigte Karte — wir erklären jeden Schritt.\nDie Demo kannst du jederzeit beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll play 2 guided rounds together.\nTap the card we show you — we’ll explain each step.\nYou can end the demo anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jugaremos 2 rondas guiadas.\nToca la carta que te mostramos; te explicamos cada paso.\nPuedes terminar la demo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On joue 2 tours guidés ensemble.\nTouche la carte indiquée — on explique chaque étape.\nTu peux finir la démo à tout moment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम साथ में 2 गाइडेड राउंड खेलेंगे।\nदिखाए गए पत्ते पर टैप करें — हर कदम समझाएंगे।\nडेमो कभी भी खत्म कर सकते हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一緒に2ラウンド案内します。\n示す札をタップ。そのつど説明します。\nいつでもデモを終了できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos jogar 2 rodadas guiadas.\nToque a carta que mostramos — explicamos cada passo.\nPode encerrar a demo a qualquer momento."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikte 2 yönlendirmeli tur oynayacağız.\nGösterdiğimiz karta dokun; her adımı birlikte anlayalım.\nDemoyu istediğin an bitirebilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们一起玩2轮引导对局。\n点我们标出的牌，边玩边讲。\n随时可以结束演示。"
          }
        }
      }
    },
