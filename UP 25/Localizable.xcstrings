    "demo.coach.done" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه هي الفكرة. إلى القائمة — أو المس ؟ للقواعد كاملة في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist der Gedanke. Weiter zum Menü — oder tippe ? für die Regeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That’s the idea. Onto the main menu — or tap ? anytime for the full rules."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa es la idea. Al menú — o toca ? cuando quieras para las reglas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voilà l’idée. Au menu — ou touche ? pour les règles complètes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यही बात है। मेनू पर — पूरे नियम के लिए कभी भी ? दबाओ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要点はこれ。メニューへ — ルール全文はいつでも？から。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É essa a ideia. Ao menu — ou toque ? a qualquer momento para as regras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşte mantık bu. Ana menüye geçiyoruz — tüm kurallar için istediğin an ?’ye bak."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就是这样。进入主菜单 — 随时点?查看完整规则。"
          }
        }
      }
    },
    "demo.coach.exactCap" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاص: المجموع تمامًا 25 أو 40 — ينجو صاحب الدور ويسحب الثلاثة ورقة لكل منهم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besonders: genau 25 oder 40 — Zugführer sicher; die anderen drei ziehen je 1."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Special: total exactly 25 or exactly 40 — holder is safe; the other three each draw 1 card."
          }
        },
        "es" : {
