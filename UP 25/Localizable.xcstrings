    "auth.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العب ضد الطاولة.\nسجّل الدخول عبر Game Center لحفظ إحصاءاتك عبر الأجهزة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele gegen den Tisch.\nMelde dich mit Game Center an, damit deine Statistik geräteübergreifend bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play against the table.\nSign in with Game Center to keep your stats across devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juega contra la mesa.\nInicia sesión con Game Center para guardar tus estadísticas en todos tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joue contre la table.\nConnecte-toi avec Game Center pour garder tes stats sur tous tes appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेज़ के ख़िलाफ़ खेलें।\nअपने आँकड़े सभी डिवाइसों पर रखने के लिए Game Center से साइन इन करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卓に向かってプレイ。\nGame Centerでサインインすると、統計が端末をまたいで保存されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogue contra a mesa.\nEntre com o Game Center para manter suas estatísticas em todos os dispositivos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masaya karşı oyna.\nİstatistiklerini saklayabilmek için Game Center ile giriş yap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与牌桌对战。\n使用 Game Center 登录，即可在各设备间保留你的统计数据。"
