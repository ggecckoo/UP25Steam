    "settings.terms.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By using 25-40 you agree to these Terms. The App is a single-player card game with no wagering or purchases. Game Center sign-in is optional and only stores statistics. You may delete your account in Settings. The App is provided as is. Contact: info@atikolabs.com"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By using 25-40 you agree to these Terms. The App is a single-player card game with no wagering or purchases. Game Center sign-in is optional and only stores statistics. You may delete your account in Settings. The App is provided as is. Contact: info@atikolabs.com"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By using 25-40 you agree to these Terms. The App is a single-player card game with no wagering, in-app purchases, subscriptions, or advertising. The Steam version is offline; Game Center is optional on supported Apple versions. Store purchases and refunds are handled by the relevant platform. The App is provided as is. Contact: info@atikolabs.com"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By using 25-40 you agree to these Terms. The App is a single-player card game with no wagering or purchases. Game Center sign-in is optional and only stores statistics. You may delete your account in Settings. The App is provided as is. Contact: info@atikolabs.com"
          }
        },
