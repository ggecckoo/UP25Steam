    "auth.offlineNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول عبر Game Center لحفظ إحصاءاتك عبر الأجهزة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit Game Center an, damit deine Statistik geräteübergreifend bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in with Game Center to keep your stats across devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con Game Center para guardar tus estadísticas en todos tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte-toi avec Game Center pour garder tes stats sur tous tes appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने आँकड़े सभी डिवाइसों पर रखने के लिए Game Center से साइन इन करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game Centerでサインインすると、統計が端末をまたいで保存されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre com o Game Center para manter suas estatísticas em todos os dispositivos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstatistiklerini saklayabilmek için Game Center ile giriş yap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Game Center 登录，即可在各设备间保留你的统计数据。"
          }
        }
      }
    },
