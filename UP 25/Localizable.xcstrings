    "settings.deleteConfirmMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف ملف 25-40 وإحصاءاتك نهائيًا. حساب Game Center لدى Apple لا يُحذف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein 25-40-Profil und deine Spielstatistiken werden dauerhaft gelöscht. Dein Game-Center-Konto bei Apple bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes your 25-40 profile and game stats. Your Game Center account with Apple is not deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán de forma permanente tu perfil de 25-40 y tus estadísticas. Tu cuenta de Game Center en Apple no se elimina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton profil 25-40 et tes statistiques seront définitivement supprimés. Ton compte Game Center chez Apple n’est pas supprimé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी 25-40 प्रोफ़ाइल और आँकड़े स्थायी रूप से हट जाएँगे। Apple पर Game Center खाता नहीं हटेगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25-40のプロフィールとプレイ統計は完全に削除されます。AppleのGame Centerアカウントは削除されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu perfil do 25-40 e estatísticas serão excluídos permanentemente. Sua conta do Game Center na Apple não é excluída."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25-40 profilin ve oyun istatistiklerin kalıcı olarak silinir. Apple’daki Game Center hesabın silinmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将永久删除你的 25-40 资料与游戏统计。Apple 上的 Game Center 账户不会被删除。"
          }
        }
      }
    },
