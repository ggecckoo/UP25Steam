    "menu.blurb" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يحين دورك يجب أن يتجاوز مجموع الأوراق الملقاة على الطاولة 25. بعد 12 جولة يفوز من لديه أقل عدد وأقل قيمة من الأوراق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du am Zug bist, muss die Summe der auf den Tisch gelegten Karten 25 überschreiten. Nach 12 Runden gewinnt, wer die wenigsten und niedrigsten Karten hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your turn, the cards played to the table must total more than 25. After 12 rounds, whoever has the fewest and lowest-value cards wins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu turno, el total de las cartas jugadas en la mesa debe superar 25. Tras 12 rondas, gana quien tenga menos cartas y de menor valor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À ton tour, le total des cartes jouées sur la table doit dépasser 25. Après 12 tours, gagne celui qui a le moins de cartes et de plus faible valeur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब तुम्हारी बारी हो, मेज पर फेंके गए पत्तों का योग 25 से अधिक होना चाहिए। 12 राउंड बाद सबसे कम और सबसे कम मान वाले पत्ते वाला जीतेगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の番では場に出た札の合計が25を超えなければならない。12ラウンド後、枚数が最も少なく点数が最も低い手が勝ち。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na sua vez, o total das cartas jogadas na mesa deve passar de 25. Após 12 rodadas, vence quem tiver menos cartas e de menor valor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıra sendeyken masaya atılan kartların toplamı 25'i aşmalı. 12 turun sonunda en az sayıda ve en düşük değerde kartları olan kazanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轮到你时，打到桌上的牌总和必须超过25。12轮后，牌最少且点数最低者获胜。"
          }
        }
      }
    },
