    "rules.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحصل الجميع على 13 ورقة. اللعبة 12 جولة وتُوزَّع الورقة كلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder erhält 13 Karten. Das Spiel geht über 12 Runden; das ganze Deck wird verteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone gets 13 cards. The game lasts 12 rounds; the deal uses the whole deck."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada uno recibe 13 cartas. La partida dura 12 rondas; se reparte todo el mazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun reçoit 13 cartes. La partie dure 12 tours ; tout le paquet est distribué."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबको 13 पत्ते मिलते हैं। खेल 12 राउंड का है; पूरी गड्डी बँटती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員13枚。全12ラウンドでデッキを配り切る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos recebem 13 cartas. O jogo tem 12 rodadas; o baralho inteiro é distribuído."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkes 13 kart alır. Oyun 12 tur sürer; deste tamamen dağıtılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每人13张牌。共12轮；整副牌发完。"
          }
        }
      }
    },
    "rules.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في كل جولة يرمي أربعة لاعبين ورقة مغلقة بالدور. تُكشف الأوراق وتُجمع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Runde legen vier Spieler reihum eine verdeckte Karte. Die Karten werden aufgedeckt und addiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each round, four players play one face-down card in turn. The cards are revealed and added up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cada ronda, cuatro jugadores tiran una carta boca abajo por turno. Se revelan y se suman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque tour, quatre joueurs posent une carte face cachée. Les cartes sont révélées et additionnées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर राउंड चार खिलाड़ी बारी-बारी एक उल्टा पत्ता डालते हैं। पत्ते खुलकर जुड़ते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ラウンド、4人が伏せ札を順に1枚出す。札を公開して合計する。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em cada rodada, quatro jogadores jogam uma carta virada por vez. As cartas são reveladas e somadas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her tur dört oyuncu sırayla birer kartı kapalı atar. Kartlar açılır ve toplanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每轮四名玩家依次扣下一张牌。亮出后合计。"
          }
        }
      }
    },
    "rules.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يكون الدور لك يجب أن يتجاوز مجموع الطاولة 25."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Zugführer bist, muss die Tischsumme 25 überschreiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your turn as holder, the table total must exceed 25."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando eres el dueño del turno, el total de la mesa debe superar 25."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand tu es le maître du tour, le total de la table doit dépasser 25."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब तुम्हारी बारी हो, मेज का योग 25 से अधिक होना चाहिए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "親の番では場の合計が25を超えなければならない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na sua vez como dono, o total da mesa deve passar de 25."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıra sendeyken masaya atılan kartların toplamı 25'i aşmalı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轮到你坐庄时，桌上合计必须超过25。"
          }
        }
      }
    },
    "rules.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن تجاوز المجموع 25 لا يسحب صاحب الدور. وإن لم يتجاوز، يسحب ورقتين عشوائيًا من الأوراق الأربع الملقاة في الوسط في تلك الجولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird 25 überschritten, zieht der Zugführer keine Karte. Wird sie nicht überschritten, zieht er zufällig 2 der vier in dieser Runde in die Mitte gelegten Karten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If 25 is exceeded, the holder draws no cards. If not, they draw 2 random cards from the four played to the middle that turn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se supera 25, el dueño del turno no roba. Si no se supera, roba al azar 2 de las cuatro cartas jugadas al centro en ese turno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si 25 est dépassé, le maître de tour ne pioche pas. Sinon, il pioche au hasard 2 des quatre cartes jouées au centre pendant ce tour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर 25 पार हो जाए तो धारक पत्ता नहीं लेता। नहीं तो उस दौर में बीच में फेंके गए चार पत्तों में से यादृच्छिक 2 लेता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25を超えた場合、親はカードを引かない。超えなければ、そのターンに場へ出された4枚からランダムに2枚引く。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se 25 for ultrapassado, o dono da vez não compra. Se não for, compra aleatoriamente 2 das quatro cartas jogadas ao centro naquela rodada."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25 aşılırsa sıra sahibi kart çekmez. Aşılmazsa ortaya o turda atılan dört karttan rastgele 2 kart çeker."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若超过25，坐庄者不抽牌。若未超过，则从该回合打到中间的四张牌中随机抽2张。"
          }
        }
      }
    },
    "rules.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان المجموع تمامًا 25 أو 40 ينجو صاحب الدور ويسحب الثلاثة الآخرون ورقة لكل منهم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei genau 25 oder 40 ist der Zugführer sicher; die anderen drei ziehen je eine Karte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the total is exactly 25 or exactly 40, the holder is safe and the other three each draw one card."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el total es exactamente 25 o 40, el dueño se salva y los otros tres roban una cada uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le total est exactement 25 ou 40, le maître est sauvé et les trois autres piochent une carte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "योग ठीक 25 या 40 हो तो धारक बचता है, बाकी तीन एक-एक कार्ड लेते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合計がぴったり25または40なら親は安全で、他の3人が1枚ずつ引く。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o total for exatamente 25 ou 40, o dono se salva e os outros três compram uma cada."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplam tam 25 veya tam 40 ise sıra sahibi kurtulur, diğer üç oyuncu birer kart çeker."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合计正好25或40时，坐庄者安全，另外三人各抽1张。"
          }
        }
      }
    },
    "rules.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد 12 جولة يفوز من لديه أقل عدد وأقل قيمة من الأوراق. النقاط = القيمة + 4 جزاء لكل ورقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach 12 Runden gewinnt, wer die wenigsten und niedrigsten Karten hat. Punkte = Werte + 4 Strafe je Karte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After 12 rounds, whoever has the fewest and lowest-value cards wins. Score = card values + 4 penalty per card."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras 12 rondas, gana quien tenga menos cartas y de menor valor. Puntos = valor + 4 de penalización por carta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après 12 tours, gagne celui qui a le moins de cartes et de plus faible valeur. Score = valeur + 4 de pénalité par carte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 राउंड बाद सबसे कम और सबसे कम मान वाले पत्ते वाला जीतेगा। स्कोर = मान + प्रति पत्ता 4 जुर्माना।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12ラウンド後、枚数が最も少なく点数が最も低い手が勝ち。得点＝点数＋1枚あたり罰則4。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após 12 rodadas, vence quem tiver menos cartas e de menor valor. Pontos = valor + 4 de penalidade por carta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 turun sonunda en az sayıda ve en düşük değerde kartları olan kazanır. Puan = kart değeri + kart başına 4 ceza."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12轮后，牌最少且点数最低者获胜。得分=点数+每张4罚分。"
          }
        }
      }
    },
