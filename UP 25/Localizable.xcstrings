    "settings.privacy.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25-40 is published by Atiko Labs. You can play without an account. If you sign in with Game Center we store your team player ID, display name, and game statistics via Supabase (EU). We do not sell your data or track you. Delete your account anytime in Settings → Account management. Contact: info@atikolabs.com"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25-40 is published by Atiko Labs. You can play without an account. If you sign in with Game Center we store your team player ID, display name, and game statistics via Supabase (EU). We do not sell your data or track you. Delete your account anytime in Settings → Account management. Contact: info@atikolabs.com"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25-40 is published by Atiko Labs. The Steam version plays offline and does not send us your Steam identity or gameplay data. The Apple version can optionally store Game Center identity and statistics via Supabase (EU). Local preferences and progress stay on your device unless you enable platform cloud sync. We do not sell data or track you. Contact: info@atikolabs.com"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25-40 is published by Atiko Labs. You can play without an account. If you sign in with Game Center we store your team player ID, display name, and game statistics via Supabase (EU). We do not sell your data or track you. Delete your account anytime in Settings → Account management. Contact: info@atikolabs.com"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25-40 is published by Atiko Labs. You can play without an account. If you sign in with Game Center we store your team player ID, display name, and game statistics via Supabase (EU). We do not sell your data or track you. Delete your account anytime in Settings → Account management. Contact: info@atikolabs.com"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25-40 is published by Atiko Labs. You can play without an account. If you sign in with Game Center we store your team player ID, display name, and game statistics via Supabase (EU). We do not sell your data or track you. Delete your account anytime in Settings → Account management. Contact: info@atikolabs.com"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25-40 is published by Atiko Labs. You can play without an account. If you sign in with Game Center we store your team player ID, display name, and game statistics via Supabase (EU). We do not sell your data or track you. Delete your account anytime in Settings → Account management. Contact: info@atikolabs.com"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25-40 is published by Atiko Labs. You can play without an account. If you sign in with Game Center we store your team player ID, display name, and game statistics via Supabase (EU). We do not sell your data or track you. Delete your account anytime in Settings → Account management. Contact: info@atikolabs.com"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25-40 Atiko Labs tarafından yayımlanır. Steam sürümü çevrimdışı oynanır; Steam kimliğinizi veya oynanış verinizi bize göndermez. Apple sürümü isteğe bağlı Game Center kimliği ve istatistiklerini Supabase (AB) üzerinden saklayabilir. Yerel tercihler ve ilerleme, platform bulut eşzamanlamasını açmadığınız sürece cihazınızda kalır. Veri satmayız ve sizi takip etmeyiz. İletişim: info@atikolabs.com"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25-40 is published by Atiko Labs. You can play without an account. If you sign in with Game Center we store your team player ID, display name, and game statistics via Supabase (EU). We do not sell your data or track you. Delete your account anytime in Settings → Account management. Contact: info@atikolabs.com"
          }
        }
      }
    },
