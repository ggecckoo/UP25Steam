"AppBuild"
{
    "AppID" "<APP_ID>"
    "Desc" "25-40 macOS, Windows, and Linux"
    "BuildOutput" "../build/steampipe-output"
    "ContentRoot" "../dist"
    "SetLive" ""
    "Preview" "0"

    "Depots"
    {
        "<MACOS_DEPOT_ID>" "depot_build_MACOS_DEPOT_ID.vdf"
        "<WINDOWS_DEPOT_ID>" "depot_build_WINDOWS_DEPOT_ID.vdf"
        "<LINUX_DEPOT_ID>" "depot_build_LINUX_DEPOT_ID.vdf"
    }
}
