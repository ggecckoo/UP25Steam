# Supabase CLI — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Dashboard URL: https://supabase.com/dashboard/project/<PROJECT_REF>
# Boş bırakılırsa setup script yeni proje oluşturur (ORG_ID gerekir).
SUPABASE_PROJECT_REF=

# Organizasyon id (supabase orgs list)
SUPABASE_ORG_ID=

# Yeni proje adı / bölge
SUPABASE_PROJECT_NAME=yirmibes
SUPABASE_REGION=eu-central-1

# İlk `supabase link` / create için (Project Settings → Database → password)
SUPABASE_DB_PASSWORD=
